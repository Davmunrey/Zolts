{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zolts.dev/schema/program/v1.json",
  "title": "Zolts Program",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "zolts/v1"
    },
    "kind": {
      "const": "Program"
    },
    "metadata": {
      "type": "object",
      "required": [
        "key",
        "version",
        "name"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "owner": {
          "type": "string"
        },
        "blueprint": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60,
          "description": "Human-readable name shown in the console. The key is an identifier, not a label."
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "trigger",
        "audience",
        "score",
        "route",
        "plays",
        "experiment",
        "budget",
        "exit"
      ],
      "properties": {
        "trigger": {
          "type": "object",
          "required": [
            "events",
            "window"
          ],
          "properties": {
            "events": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "signal": {
                    "type": "string"
                  },
                  "where": {
                    "type": "string"
                  }
                },
                "required": [
                  "signal"
                ]
              }
            },
            "combine": {
              "enum": [
                "any_within",
                "all_within",
                "sequence"
              ]
            },
            "window": {
              "type": "string",
              "pattern": "^\\d+[hdw]$"
            },
            "dedupe": {
              "type": "object",
              "properties": {
                "key": {
                  "enum": [
                    "account_id",
                    "person_id",
                    "membership_id"
                  ]
                },
                "cooldown": {
                  "type": "string",
                  "pattern": "^\\d+[dw]$"
                }
              }
            }
          }
        },
        "audience": {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "sql"
              ]
            },
            {
              "required": [
                "segment_ref"
              ]
            }
          ],
          "properties": {
            "sql": {
              "type": "string"
            },
            "segment_ref": {
              "type": "string"
            }
          }
        },
        "enrich": {
          "type": "object",
          "properties": {
            "account": {
              "$ref": "#/$defs/enrichBlock"
            },
            "person": {
              "$ref": "#/$defs/enrichBlock"
            }
          }
        },
        "score": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "formula": {
              "type": "string"
            },
            "weights": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "explain": {
              "type": "boolean",
              "default": true
            },
            "floor": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "anyOf": [
            {
              "required": [
                "model"
              ]
            },
            {
              "required": [
                "formula"
              ]
            }
          ]
        },
        "route": {
          "type": "object",
          "required": [
            "tiers"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "score_desc",
                "territory_round_robin",
                "owner_of_record"
              ]
            },
            "tiers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "when"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "when": {
                    "type": "string"
                  },
                  "capacity_per_week": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "capacity_per_week_per_rep": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "plays": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "steps"
            ],
            "properties": {
              "template": {
                "type": "string"
              },
              "auto_send": {
                "type": "boolean",
                "default": false
              },
              "auto_send_requires": {
                "type": "object",
                "properties": {
                  "eval_score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "policy": {
                    "enum": [
                      "allow"
                    ]
                  }
                }
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "step"
                  ],
                  "properties": {
                    "step": {
                      "type": "string"
                    },
                    "channel": {
                      "enum": [
                        "email",
                        "linkedin",
                        "ads",
                        "voice",
                        "sms",
                        "whatsapp",
                        "product",
                        "task",
                        "webhook"
                      ]
                    },
                    "agent": {
                      "enum": [
                        "researcher",
                        "strategist",
                        "copywriter",
                        "qualifier",
                        "ops",
                        "analyst"
                      ]
                    },
                    "wait": {
                      "type": "string",
                      "pattern": "^\\d+[hdw]$"
                    },
                    "template": {
                      "type": "string"
                    },
                    "sla_hours": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "when": {
                      "type": "string",
                      "description": "Condition on `engagement` deciding whether this step runs at all, in the same expression language as triggers and exit rules. Available: engagement.has_replied, has_opened, no_response, opened, replied, bounced, sent, converted, and tier. A step with no `when` always runs."
                    }
                  }
                }
              }
            }
          }
        },
        "policy": {
          "type": "object",
          "properties": {
            "inherit": {
              "type": "string"
            },
            "overrides": {
              "type": "object",
              "description": "Only overrides stricter than the tenant policy are accepted.",
              "properties": {
                "quiet_hours": {
                  "type": "object"
                },
                "max_touches_per_person_per_week": {
                  "type": "integer",
                  "minimum": 0
                },
                "channels_require_basis": {
                  "type": "object"
                },
                "lists_check": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "experiment": {
          "type": "object",
          "required": [
            "holdout_pct",
            "unit",
            "primary_metric"
          ],
          "properties": {
            "holdout_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 50
            },
            "holdout_waiver_reason": {
              "type": "string"
            },
            "unit": {
              "enum": [
                "account",
                "person",
                "territory",
                "geo"
              ]
            },
            "salt": {
              "type": "string"
            },
            "primary_metric": {
              "type": "string"
            },
            "guardrail_metrics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "holdout_pct": {
                    "maximum": 4.999
                  }
                }
              },
              "then": {
                "required": [
                  "holdout_waiver_reason"
                ]
              }
            }
          ]
        },
        "budget": {
          "type": "object",
          "required": [
            "monthly_credits"
          ],
          "properties": {
            "monthly_credits": {
              "type": "number",
              "minimum": 0
            },
            "max_cost_per_account": {
              "type": "number"
            },
            "max_cost_per_person": {
              "type": "number"
            },
            "max_cost_per_meeting": {
              "type": "number"
            },
            "on_exceed": {
              "enum": [
                "pause_and_alert",
                "throttle",
                "continue_and_alert"
              ]
            }
          }
        },
        "exit": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "when",
              "reason"
            ],
            "properties": {
              "when": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "suppress": {
                "type": "boolean"
              }
            }
          }
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "description": "When steps may land. This moves a send; it never cancels one. A program that declares no schedule lands wherever its waits land, which is the behaviour every program had before this existed.",
          "properties": {
            "send_window": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "days": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "mon",
                      "tue",
                      "wed",
                      "thu",
                      "fri",
                      "sat",
                      "sun"
                    ]
                  },
                  "description": "Days the window is open. Defaults to Monday-Friday."
                },
                "opens": {
                  "type": "string",
                  "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$"
                },
                "closes": {
                  "type": "string",
                  "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$"
                },
                "timezone": {
                  "type": "string",
                  "description": "IANA name, for example Europe/Madrid. The window is the customer's local time, not the runtime's."
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "enrichBlock": {
      "type": "object",
      "properties": {
        "require": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "buying_roles": {
          "type": "array",
          "items": {
            "enum": [
              "economic",
              "champion",
              "technical",
              "user",
              "blocker"
            ]
          }
        },
        "accuracy_sla": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_contacts_per_account": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_per_account": {
          "type": "number",
          "minimum": 0
        },
        "max_cost_per_contact": {
          "type": "number",
          "minimum": 0
        },
        "skip_if_known": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
